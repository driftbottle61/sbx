#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

service_prepare() {
	[ "$(uci -q get sbx.main.enabled || echo 0)" = "1" ] || return 1
	[ "${SBX_SKIP_SYNC:-0}" = "1" ] || /usr/bin/sbx-luci-sync
}

start_service() {
	service_prepare || return 1
	procd_open_instance
	procd_set_param command /usr/bin/sing-box run -c "$(uci -q get sbx.main.config_file || echo /etc/sing-box/config.json)"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	# sing-box may still be downloading rule-sets when the main process starts.
	# Apply the route policy in a separate procd instance so it can retry after
	# the tun device appears, without blocking boot and without leaving a
	# detached shell behind after stop/restart.
	procd_open_instance route
	procd_set_param command /usr/bin/sbx-luci-route-apply
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	procd_kill
	/usr/bin/sbx-luci-route clear >/dev/null 2>&1 || true
}

restart_service() {
	stop_service
	start_service
}

reload_service() {
	restart_service
}

service_triggers() {
	procd_add_reload_trigger sbx
	procd_add_reload_trigger firewall
	procd_add_interface_trigger "interface.*" lan /etc/init.d/sbx restart
}

service_running() {
	pidof sing-box >/dev/null 2>&1
}
