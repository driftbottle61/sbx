#!/bin/sh
set -eu
kind="${1:-}"
tmpdir=/tmp/sbx-update
mkdir -p "$tmpdir"

curl_fetch() {
	url="$1"
	out="$2"
	if curl -fsS --connect-timeout 3 -x http://127.0.0.1:8080 https://api.github.com/rate_limit >/dev/null 2>&1; then
		curl -fL -x http://127.0.0.1:8080 --connect-timeout 10 --retry 2 "$url" -o "$out"
	elif curl -fsS --connect-timeout 3 --socks5-hostname 127.0.0.1:1080 https://api.github.com/rate_limit >/dev/null 2>&1; then
		curl -fL --socks5-hostname 127.0.0.1:1080 --connect-timeout 10 --retry 2 "$url" -o "$out"
	else
		curl -fL --connect-timeout 10 --retry 2 "$url" -o "$out"
	fi
}

curl_text() {
	url="$1"
	file="$tmpdir/curl-text.$$"
	curl_fetch "$url" "$file"
	cat "$file"
	rm -f "$file"
}

case "$kind" in
singbox)
	if /usr/bin/sbx-luci-version singbox | grep -q '"update_available":false'; then
		echo "sing-box is already up to date"
		exit 0
	fi
	arch=$(uname -m)
	case "$arch" in
		x86_64|amd64) asset_arch=amd64 ;;
		aarch64|arm64) asset_arch=arm64 ;;
		armv7*) asset_arch=armv7 ;;
		*) echo "unsupported architecture: $arch" >&2; exit 1 ;;
	esac
	latest=$(curl_text https://api.github.com/repos/SagerNet/sing-box/releases/latest)
	url=$(printf '%s' "$latest" | sed -n "s#.*\\\"browser_download_url\\\"[[:space:]]*:[[:space:]]*\\\"\\([^\\\"]*sing-box-[0-9.]*-linux-${asset_arch}-musl.tar.gz\\\"\).*#\\1#p" | head -n1)
	[ -n "$url" ] || { echo "no matching sing-box musl asset" >&2; exit 1; }
	archive="$tmpdir/sing-box.tar.gz"
	curl_fetch "$url" "$archive"
	newbin="$tmpdir/sing-box"
	tar -xzf "$archive" -O "$(tar -tzf "$archive" | grep '/sing-box$' | head -n1)" > "$newbin"
	chmod 0755 "$newbin"
	config="$(uci -q get sbx.main.config_file || echo /etc/sing-box/config.json)"
	if [ -f "$config" ]; then
		"$newbin" check -c "$config" >/dev/null
	fi
	/etc/init.d/sbx stop >/dev/null 2>&1 || true
	cp "$newbin" /usr/bin/sing-box
	if [ -f "$config" ]; then
		/etc/init.d/sbx start >/dev/null 2>&1 || true
	fi
	;;
sbx)
	if /usr/bin/sbx-luci-version sbx | grep -q '"update_available":false'; then
		echo "SBX/OpenWrt is already up to date"
		exit 0
	fi
	latest=$(/usr/bin/sbx-luci-version sbx | sed -n 's/.*"latest":"v\([0-9.]*\)".*/\1/p')
	[ -n "$latest" ] || { echo "unable to determine latest OpenWrt release" >&2; exit 1; }
	release_tag="openwrt-v${latest}"
	if [ -n "${SBX_OPENWRT_PACKAGE_URL:-}" ]; then
		url="$SBX_OPENWRT_PACKAGE_URL"
	else
		release=$(curl_text "https://api.github.com/repos/driftbottle61/sbx/releases/tags/${release_tag}")
		url=$(printf '%s' "$release" | sed -n 's#.*"browser_download_url"[[:space:]]*:[[:space:]]*"\([^"]*luci-app-sbx-[^"]*\.apk\)".*#\1#p' | head -n1)
	fi
	[ -n "$url" ] || { echo "no SBX APK asset found in ${release_tag}" >&2; exit 1; }
	file="$tmpdir/luci-app-sbx-${latest}.apk"
	rm -f "$file"
	curl_fetch "$url" "$file"
	if apk info -e luci-app-sbx >/dev/null 2>&1; then
		apk del luci-app-sbx
	fi
	apk add --allow-untrusted "$file"
	/etc/init.d/rpcd reload >/dev/null 2>&1 || /etc/init.d/rpcd restart >/dev/null 2>&1 || true
	installed=$(apk info -a luci-app-sbx 2>/dev/null | sed -n 's/^luci-app-sbx-\([^ ]*\) description:.*/\1/p' | head -n1 | sed 's/-r[0-9]*$//')
	[ "$installed" = "$latest" ] || { echo "installed version mismatch: expected $latest, got ${installed:-unknown}" >&2; exit 1; }
	;;
*) echo "usage: $0 {singbox|sbx}" >&2; exit 2 ;;
esac
echo "updated $kind"
