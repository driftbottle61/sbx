#!/bin/sh

action="$1"
case "$action" in
	update-singbox)
		/usr/bin/sbx-luci-update singbox
		;;
	update-sbx)
		/usr/bin/sbx-luci-update sbx
		;;
	apply-mode)
		profile="${2:-}"
		case "$profile" in tun|tproxy|proxy-only) ;; *) echo "invalid mode" >&2; exit 2 ;; esac
		/usr/bin/sbx-luci-action update-restart "$profile"
		;;
	update-restart)
		/usr/bin/sbx-luci-transaction "${2:-$(uci -q get sbx.main.config_profile || echo proxy-only)}"
		;;
	start|stop|restart|reload|status)
		if [ "$action" = "stop" ]; then
			/usr/bin/sbx-luci-route clear >/dev/null 2>&1 || true
		elif [ "$action" != "status" ]; then
			/usr/bin/sbx-luci-sync || { echo "active mode configuration download/validation failed" >&2; exit 1; }
		fi
		/etc/init.d/sbx "$action" >/dev/null 2>&1
		if [ "$action" != "stop" ] && [ "$action" != "status" ]; then
			/usr/bin/sbx-luci-route apply || { echo "route policy setup failed" >&2; exit 1; }
		fi
		/usr/bin/sbx-luci-status
		;;
	check)
		profile=$(uci -q get sbx.main.config_profile || uci -q get sbx.main.mode || echo proxy-only)
		if [ "$profile" = "tun" ] || [ "$profile" = "tproxy" ]; then
			/usr/bin/sbx-luci-sync || exit 1
		fi
		if /usr/bin/sing-box check -c "$(uci -q get sbx.main.config_file || echo /etc/sing-box/config.json)" >/tmp/sbx-check.out 2>&1; then
			printf '{"ok":true,"output":"configuration valid"}\n'
		else
			printf '{"ok":false,"output":"configuration invalid"}\n'
		fi
		;;
	log)
		out=$(logread | grep -i -E 'sing-box|sbx' | tail -30 || true)
		if [ -n "$out" ]; then printf '%s\n' "$out"; else
			printf '%s\n' '当前 sing-box 未写入系统 logread（procd 正常运行但没有日志输出）。'
			printf '%s\n' '最近 SBX/APK 操作日志：'
			tail -30 /var/log/apk.log 2>/dev/null || true
		fi
		;;
	route-status)
		/usr/bin/sbx-luci-route status
		;;
	*)
		echo "unknown action" >&2
		exit 2
		;;
esac
