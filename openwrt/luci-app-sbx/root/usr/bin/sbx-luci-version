#!/bin/sh
set -eu
kind="${1:-singbox}"
case "$kind" in
singbox) local=$(/usr/bin/sing-box version 2>/dev/null | sed -n 's/.*sing-box version \([^ ]*\).*/\1/p'); repo='SagerNet/sing-box' ;;
sbx)
    local=$(apk info -a luci-app-sbx 2>/dev/null | sed -n 's/^luci-app-sbx-\([^ ]*\) description:.*/\1/p' | head -n1 || true)
    [ -n "$local" ] || local='unknown'
    local=${local%-r*}
    repo=''
    latest=$(curl -fsSL --connect-timeout 10 "https://api.github.com/repos/driftbottle61/sbx/contents/openwrt/luci-app-sbx/Makefile?ref=openwrt&ts=$(date +%s)" 2>/dev/null | jsonfilter -e '@.content' 2>/dev/null | tr -d '\n' | base64 -d 2>/dev/null | sed -n 's/^PKG_VERSION:=//p' | head -n1 || true)
    [ -n "$latest" ] || latest='unknown'
    cmp="$latest"; [ "${cmp#v}" = "$local" ] && update=false || update=true
    printf '{"local":"v%s","latest":"v%s","update_available":%s,"update_kind":"sbx"}\n' "$local" "$latest" "$update"
    exit 0
    ;;
	*) exit 2 ;;
esac
latest=''
[ -n "$repo" ] && latest=$(curl -fsSL --connect-timeout 10 "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1 || true)
[ -n "$latest" ] || latest='unknown'
cmp="$latest"; [ "${cmp#v}" = "$local" ] && update=false || update=true
printf '{"local":"v%s","latest":"%s","update_available":%s}\n' "$local" "$latest" "$update"
