#!/bin/bash

source /opt/sbx/data/sbx.conf
source /opt/sbx/lib/common.sh
source /opt/sbx/lib/system.sh
source /opt/sbx/lib/install.sh
source /opt/sbx/lib/service.sh
source /opt/sbx/lib/runtime.sh
source /opt/sbx/lib/config.sh
source /opt/sbx/lib/route.sh
source /opt/sbx/lib/tools.sh
source /opt/sbx/lib/dashboard.sh
source /opt/sbx/lib/web.sh

root_check
setup_download_proxy


while true
do

dashboard

CHOICE=""
# Refresh the terminal dashboard periodically while waiting for input.
# A timeout keeps the displayed CPU/memory values live without changing the
# existing menu semantics.
if [ "${DASHBOARD_PROMPT_DRAWN:-0}" != "1" ]; then
    printf '请选择：'
    DASHBOARD_PROMPT_DRAWN=1
fi
if ! read -r -t 2 CHOICE; then
    refresh_dashboard_metrics
    continue
fi

DASHBOARD_DRAWN=0
DASHBOARD_PROMPT_DRAWN=0


case "$CHOICE" in

1)

install_menu

;;

2)

config_menu

;;

3)

service_menu

;;

4)

route_menu

;;

5)

tools_menu

;;

6)

web_menu

;;

0)

clear
echo "退出 SBX"
exit 0

;;

*)

warn "输入错误"
pause

;;

esac

done
